<!DOCTYPE html>
<html lang="en">
<head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>{{title}} | Polaris Airlines</title>
      <!-- Bootstrap 5 -->
      <link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.
css" rel="stylesheet">
      <!-- Bootstrap Icons -->
    <link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-i
cons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>


    <!-- ── Global Navbar ── -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top
shadow-sm">
          <div class="container">
              <a class="navbar-brand fw-bold fs-4" href="/">
                  <i class="bi bi-snow"></i> Polaris
              </a>
              <button class="navbar-toggler" type="button"
data-bs-toggle="collapse" data-bs-target="#navbarNav">
                  <span class="navbar-toggler-icon"></span>
              </button>
              <div class="collapse navbar-collapse" id="navbarNav">
                  <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                     <li class="nav-item">
                          <a class="nav-link {{#if isHome}}active{{/if}}"
href="/">
                                 <i class="bi bi-house-door"></i> Home
                          </a>
                     </li>
                     <li class="nav-item">
                          <a class="nav-link {{#if isSearch}}active{{/if}}"
href="/flights/search">
                                 <i class="bi bi-search"></i> Search Flights
                          </a>
                     </li>


                     {{#if user}}
                          {{#unless isAdmin}}
                          <li class="nav-item">
                                 <a class="nav-link {{#if
isReservations}}active{{/if}}" href="/reservations">
                                    <i class="bi bi-calendar-check"></i> My
Reservations
                             </a>
                        </li>
                        {{/unless}}


                        {{#if isAdmin}}
                        <li class="nav-item">
                             <a class="nav-link {{#if
isAdminFlights}}active{{/if}}" href="/admin/flights">
                                    <i class="bi bi-airplane"></i> Manage
Flights
                             </a>
                        </li>
                        <li class="nav-item">
                             <a class="nav-link {{#if
isAdminReservations}}active{{/if}}" href="/admin/reservations">
                                    <i class="bi bi-clipboard-data"></i> All
Reservations
                             </a>
                        </li>
                        <li class="nav-item">
                             <a class="nav-link {{#if
isAdminAuditLogs}}active{{/if}}" href="/admin/audit-logs">
                                    <i class="bi bi-journal-text"></i> Audit Trail
                             </a>
                        </li>
                        {{/if}}
                   {{/if}}
                </ul>


                <ul class="navbar-nav">
                   {{#if user}}
                        <li class="nav-item dropdown">
                             <a class="nav-link dropdown-toggle d-flex
align-items-center gap-2"
                                href="#" role="button"
data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    {{user.firstName}}
                                    {{#if isAdmin}}
                                        <span class="badge bg-warning
text-dark" style="font-size:0.65rem;">Admin</span>
                                    {{/if}}
                             </a>
                             <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="px-3 py-2 border-bottom">
                                           <div class="fw-semibold
small">{{user.firstName}} {{user.lastName}}</div>
                                           <div class="text-muted"
style="font-size:0.78rem;">{{user.email}}</div>
                                    </li>
                                    <li>
                                           <a class="dropdown-item"
href="/profile">
                                                  <i class="bi bi-person-fill
me-2"></i> Profile
                                           </a>
                                    </li>
                                    {{#if isAdmin}}
                                    <li>
                                           <a class="dropdown-item"
href="/admin/flights">
                                                  <i class="bi bi-speedometer2
me-2"></i> Admin Panel
                                           </a>
                                    </li>
                                    {{/if}}
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                           <a class="dropdown-item text-danger"
href="#" id="logoutBtn">
                                                  <i class="bi bi-box-arrow-right
me-2"></i> Logout
                                           </a>
                                    </li>
                             </ul>
                         </li>
                     {{else}}
                         <li class="nav-item">
                             <a class="nav-link {{#if
isLogin}}active{{/if}}" href="/login">
                                    <i class="bi bi-box-arrow-in-right
me-1"></i> Login
                             </a>
                         </li>
                          <li class="nav-item">
                                 <a class="btn btn-outline-light btn-sm ms-2
my-auto" href="/register">
                                        Register
                                 </a>
                          </li>
                       {{/if}}
                  </ul>
              </div>
        </div>
    </nav>


    <!-- ── Flash Messages ── -->
    {{#if flashSuccess}}
    <div class="alert alert-success alert-dismissible fade show mb-0
rounded-0" role="alert">
        <div class="container">
              <i class="bi bi-check-circle-fill me-2"></i>{{flashSuccess}}
              <button type="button" class="btn-close"
data-bs-dismiss="alert"></button>
        </div>
    </div>
    {{/if}}
    {{#if flashError}}
    <div class="alert alert-danger alert-dismissible fade show mb-0
rounded-0" role="alert">
        <div class="container">
              <i class="bi bi-exclamation-triangle-fill
me-2"></i>{{flashError}}
              <button type="button" class="btn-close"
data-bs-dismiss="alert"></button>
        </div>
    </div>
    {{/if}}


    <!-- ── Page Content ── -->
    <main>
        {{{body}}}
    </main>
    <!-- ── Global Footer ── -->
    <footer class="bg-dark text-white pt-5 pb-4 mt-5">
        <div class="container">
           <div class="row g-4">
                <div class="col-lg-4">
                   <h5 class="fw-bold mb-3">
                         <i class="bi bi-snow"></i> Polaris Airlines
                   </h5>
                   <p class="text-light small">
                         Your trusted partner for comfortable and
affordable air travel
                         across the Philippines and Southeast Asia.
                   </p>
                </div>
                <div class="col-lg-4">
                   <h6 class="fw-bold mb-3"> Quick Links </h6>
                   <ul class="list-unstyled small">
                         <li class="mb-1"><a href="/" class="text-light
text-decoration-none"> Home </a></li>
                         <li class="mb-1"><a href="/flights/search"
class="text-light text-decoration-none"> Search Flights </a></li>
                         {{#if user}}
                         <li class="mb-1"><a href="/reservations"
class="text-light text-decoration-none"> My Reservations </a></li>
                         <li class="mb-1"><a href="/profile"
class="text-light text-decoration-none"> My Profile </a></li>
                         {{else}}
                         <li class="mb-1"><a href="/login"
class="text-light text-decoration-none"> Login </a></li>
                         <li class="mb-1"><a href="/register"
class="text-light text-decoration-none"> Register </a></li>
                         {{/if}}
                   </ul>
                </div>
                <div class="col-lg-4">
                   <h6 class="fw-bold mb-3"> Contact Us </h6>
                   <ul class="list-unstyled small text-light">
                         <li class="mb-1"><i class="bi bi-geo-alt
me-2"></i> Taft Ave., Malate, Manila City </li>
                                   <li class="mb-1"><i class="bi bi-telephone
me-2"></i> +63 (2) 8555-POL </li>
                                   <li class="mb-1"><i class="bi bi-envelope
me-2"></i> support@polaris.com </li>
                               </ul>
                          </div>
                      </div>
                      <hr class="my-3 border-secondary">
                      <p class="text-muted small mb-0 text-center">
                          &copy; 2026 Polaris Airlines. All rights reserved.
                      </p>
               </div>
       </footer>


       <!-- Toast Container -->
       <div id="toastContainer" class="position-fixed top-0 end-0 p-3"
style="z-index: 1100;"></div>


       <!-- jQuery -->
       <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
       <!-- Bootstrap JS -->
       <script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle
.min.js"></script>
       <!-- Shared JS -->
       <script src="/static/js/main.js"></script>
       <!-- Page-specific JS -->
       {{#if pageScript}}
       <script src="/static/js/{{pageScript}}"></script>
       {{/if}}
</body>
</html>


