<section class="bg-light min-vh-100 py-4">
       <div class="container">


               <div class="mb-4">
                     <h4 class="fw-bold mb-0"><i class="bi bi-person-circle
text-primary me-2"></i> My Profile </h4>
                     <p class="text-muted small mb-0"> Manage your personal
information </p>
           </div>


           <div class="row g-4">


              <!-- Left: Avatar + nav tabs -->
              <div class="col-lg-3">
                    <div class="card border-0 shadow-sm">
                       <div class="card-body text-center p-4">
                           <div class="bg-primary bg-opacity-10
rounded-circle d-flex align-items-center
                                          justify-content-center mx-auto mb-3"


style="width:80px;height:80px;font-size:2rem;color:#0d6efd;font-weight:700
;">
                                  {{firstInitial}}
                           </div>
                           <h5 class="fw-bold mb-0">{{user.firstName}}
{{user.lastName}}</h5>
                           <p class="text-muted small
mb-2">{{user.email}}</p>
                           <span class="badge bg-primary"> {{user.role}}
</span>
                       </div>
                       <div class="list-group list-group-flush"
id="profileTabsList">
                           <a href="#" class="list-group-item
list-group-item-action active" data-tab="personal">
                                  <i class="bi bi-person-fill me-2"></i>
Personal Info
                           </a>
                           <a href="#" class="list-group-item
list-group-item-action" data-tab="security">
                                  <i class="bi bi-shield-lock-fill me-2"></i>
Security
                           </a>
                           <a href="/reservations" class="list-group-item
list-group-item-action">
                                  <i class="bi bi-calendar-check me-2"></i> My
Reservations
                           </a>
                      </div>
                 </div>
             </div>


             <!-- Right: Tab panels -->
             <div class="col-lg-9">


                 <!-- Personal Info Panel -->
                 <div class="card border-0 shadow-sm profile-panel"
id="tab-personal">
                      <div class="card-header bg-white d-flex
justify-content-between align-items-center">
                          <h5 class="fw-bold mb-0">
                               <i class="bi bi-person-fill text-primary
me-2"></i> Personal Information
                          </h5>
                          <button class="btn btn-sm btn-outline-primary"
id="editPersonalBtn">
                               <i class="bi bi-pencil me-1"></i> Edit
                          </button>
                      </div>
                      <div class="card-body p-4">


                          <div id="profileSuccess" class="alert
alert-success d-none small py-2">
                               <i class="bi bi-check-circle-fill me-2"></i>
                               <span id="profileSuccessMsg"></span>
                          </div>
                          <div id="profileError" class="alert alert-danger
d-none small py-2">
                               <i class="bi bi-exclamation-triangle-fill
me-2"></i>
                               <span id="profileErrorMsg"></span>
                          </div>


                          <div class="row g-3">
                               <div class="col-md-6">
                                   <label class="form-label fw-semibold
small"> First Name </label>
                                    <input type="text" class="form-control"
id="profFirstName"
                                              value="{{user.firstName}}"
disabled>
                               </div>
                               <div class="col-md-6">
                                    <label class="form-label fw-semibold
small"> Last Name </label>
                                    <input type="text" class="form-control"
id="profLastName"
                                              value="{{user.lastName}}" disabled>
                               </div>
                               <div class="col-12">
                                    <label class="form-label fw-semibold
small"> Email Address </label>
                                    <input type="email" class="form-control"
id="profEmail"
                                              value="{{user.email}}" disabled>
                                    <div class="invalid-feedback"> Valid email
is required. </div>
                               </div>
                           </div>


                           <div id="profileActions" class="mt-3 d-none">
                               <button class="btn btn-primary me-2
fw-semibold" id="saveProfileBtn">
                                    <span id="saveProfileText"><i class="bi
bi-save me-1"></i> Save Changes </span>
                                    <span id="saveProfileSpinner"
class="d-none">
                                        <span class="spinner-border
spinner-border-sm me-1"></span> Saving…
                                    </span>
                               </button>
                               <button class="btn btn-outline-secondary"
id="cancelProfileBtn"> Cancel </button>
                           </div>


                      </div>
                  </div>
                  <!-- Security Panel -->
                  <div class="card border-0 shadow-sm profile-panel d-none"
id="tab-security">
                      <div class="card-header bg-white">
                          <h5 class="fw-bold mb-0">
                                 <i class="bi bi-shield-lock-fill text-primary
me-2"></i> Security Settings
                          </h5>
                      </div>
                      <div class="card-body p-4">
                          <p class="text-muted small mb-4">
                                 Your account is protected with a password. For
security, we recommend
                                 using a unique password that you don't use on
other sites.
                          </p>


                          <div id="securityInfo" class="row g-3">
                                 <div class="col-12">
                                     <div class="d-flex justify-content-between
align-items-center p-3 bg-light rounded">
                                          <div>
                                              <div class="fw-semibold small">
Password </div>
                                              <div class="text-muted small">
Last updated: Unknown </div>
                                          </div>
                                          <span class="badge bg-success">
Protected </span>
                                     </div>
                                 </div>
                                 <div class="col-12">
                                     <div class="d-flex justify-content-between
align-items-center p-3 bg-light rounded">
                                          <div>
                                              <div class="fw-semibold small">
Account Role </div>
                                              <div class="text-muted small">
{{user.role}} </div>
                                           </div>
                                           <span class="badge bg-primary"> Active
</span>
                                       </div>
                                </div>
                                <div class="col-12">
                                       <div class="d-flex justify-content-between
align-items-center p-3 bg-light rounded">
                                           <div>
                                                <div class="fw-semibold small">
Member Since </div>
                                                <div class="text-muted small">
{{memberSince}} </div>
                                           </div>
                                       </div>
                                </div>
                            </div>


                            <hr class="my-4">


                            <!-- Delete Account -->
                            <div>
                                <h6 class="fw-semibold text-danger mb-2">
Danger Zone </h6>
                                <p class="text-muted small mb-3">
                                       Once you delete your account, all your
data will be permanently removed.
                                </p>
                                <button class="btn btn-outline-danger btn-sm"
id="deleteAccountBtn">
                                       <i class="bi bi-trash me-1"></i> Delete My
Account
                                </button>
                            </div>
                      </div>
                   </div>


             </div>
          </div>
    </div>
</section>


<script>
    // ── Tab switching ──
    document.querySelectorAll('#profileTabsList a[data-tab]').forEach(link => {
           link.addEventListener('click', function (e) {
                 e.preventDefault();
                 document.querySelectorAll('#profileTabsList a').forEach(l =>
l.classList.remove('active'));
                 this.classList.add('active');
                 document.querySelectorAll('.profile-panel').forEach(p =>
p.classList.add('d-none'));
                 document.getElementById('tab-' +
this.dataset.tab).classList.remove('d-none');
           });
    });


    // ── Edit / cancel personal info ──
    document.getElementById('editPersonalBtn').addEventListener('click',
function () {
           ['profFirstName','profLastName','profEmail'].forEach(id =>
                 document.getElementById(id).disabled = false);


document.getElementById('profileActions').classList.remove('d-none');
           this.classList.add('d-none');
    });


    document.getElementById('cancelProfileBtn').addEventListener('click',
function () {
           ['profFirstName','profLastName','profEmail'].forEach(id =>
                 document.getElementById(id).disabled = true);
           document.getElementById('profileActions').classList.add('d-none');


document.getElementById('editPersonalBtn').classList.remove('d-none');
           document.getElementById('profileSuccess').classList.add('d-none');
           document.getElementById('profileError').classList.add('d-none');
           ['profFirstName','profLastName','profEmail'].forEach(id =>
                 document.getElementById(id).classList.remove('is-invalid'));
    });
    // ── Save profile via AJAX ──
    document.getElementById('saveProfileBtn').addEventListener('click',
async function () {
         const firstName =
document.getElementById('profFirstName').value.trim();
         const lastName   =
document.getElementById('profLastName').value.trim();
         const email      =
document.getElementById('profEmail').value.trim();


         document.getElementById('profileSuccess').classList.add('d-none');
         document.getElementById('profileError').classList.add('d-none');
         ['profFirstName','profLastName','profEmail'].forEach(id =>
             document.getElementById(id).classList.remove('is-invalid'));


         let valid = true;
         if (!firstName) {
document.getElementById('profFirstName').classList.add('is-invalid');
valid = false; }
         if (!lastName)   {
document.getElementById('profLastName').classList.add('is-invalid');
valid = false; }
         if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {


document.getElementById('profEmail').classList.add('is-invalid'); valid =
false;
         }
         if (!valid) return;



document.getElementById('saveProfileText').classList.add('d-none');


document.getElementById('saveProfileSpinner').classList.remove('d-none');
         this.disabled = true;


         try {
             const res    = await fetch('/api/users/profile', {
                   method: 'PUT',
                   headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ firstName, lastName, email })
              });
              const data = await res.json();


              if (data.success) {
                    document.getElementById('profileSuccessMsg').textContent =
'Profile updated successfully!';


document.getElementById('profileSuccess').classList.remove('d-none');
                    ['profFirstName','profLastName','profEmail'].forEach(id =>
                        document.getElementById(id).disabled = true);


document.getElementById('profileActions').classList.add('d-none');


document.getElementById('editPersonalBtn').classList.remove('d-none');
              } else {
                    document.getElementById('profileErrorMsg').textContent =
data.message || 'Update failed.';


document.getElementById('profileError').classList.remove('d-none');
              }
          } catch (_) {
              document.getElementById('profileErrorMsg').textContent =
'Network error. Please try again.';


document.getElementById('profileError').classList.remove('d-none');
          } finally {


document.getElementById('saveProfileText').classList.remove('d-none');


document.getElementById('saveProfileSpinner').classList.add('d-none');
              this.disabled = false;
          }
    });


    // ── Delete account ──
    document.getElementById('deleteAccountBtn').addEventListener('click',
async function () {
          if (!confirm('Are you sure you want to permanently delete your account? This cannot be undone.')) return;
                try {
                    const res    = await fetch('/api/users/profile', { method:
'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        window.location.href = '/?deleted=true';
                    } else {
                        alert(data.message || 'Could not delete account.');
                    }
                } catch (_) {
                    alert('Network error. Please try again.');
                }
       });
</script>


