<section class="bg-primary text-white py-4">
      <div class="container">
              <h4 class="fw-bold mb-0"><i class="bi bi-search me-2"></i> Search
Flights </h4>
              <p class="opacity-75 small mb-0"> Find the best flights for your
trip </p>
      </div>
</section>
<section class="bg-light py-4">
    <div class="container">


        <!-- Search Form -->
        <div class="card shadow-sm border-0 mb-4">
              <div class="card-body p-4">
                  <div class="row g-3 align-items-end">
                     <div class="col-md-3">
                         <label for="origin" class="form-label fw-semibold
small"> From </label>
                         <div class="input-group">
                              <span class="input-group-text"><i class="bi
bi-geo-alt-fill text-primary"></i></span>
                              <input type="text" class="form-control"
id="origin"
                                      placeholder="e.g. Manila"
value="{{searchParams.origin}}">
                         </div>
                     </div>
                     <div class="col-md-3">
                         <label for="destination" class="form-label
fw-semibold small"> To </label>
                         <div class="input-group">
                              <span class="input-group-text"><i class="bi
bi-geo-alt text-danger"></i></span>
                              <input type="text" class="form-control"
id="destination"
                                      placeholder="e.g. Cebu"
value="{{searchParams.destination}}">
                         </div>
                     </div>
                     <div class="col-md-3">
                         <label for="departureDate" class="form-label
fw-semibold small"> Departure Date </label>
                         <div class="input-group">
                              <span class="input-group-text"><i class="bi
bi-calendar3"></i></span>
                              <input type="date" class="form-control"
id="departureDate"
                                      value="{{searchParams.departureDate}}">
                          </div>
                     </div>
                     <div class="col-md-3">
                          <button type="button" class="btn btn-primary w-100
py-2 fw-semibold" id="searchBtn">
                              <i class="bi bi-search me-2"></i> Search
                          </button>
                     </div>
                 </div>
            </div>
        </div>


        <!-- Sort bar -->
        <div class="d-flex justify-content-between align-items-center mb-3
flex-wrap gap-2" id="sortBar" style="display:none!important;">
            <div class="small text-muted" id="resultCount"></div>
            <div class="d-flex align-items-center gap-2">
                 <label class="small fw-semibold mb-0"> Sort by: </label>
                 <select class="form-select form-select-sm" id="sortSelect"
style="width:180px;">
                     <option value="departureDateTime"> Departure Time
</option>
                     <option value="ticketPrice"> Price: Low → High
</option>
                     <option value="ticketPriceDesc"> Price: High → Low
</option>
                 </select>
            </div>
        </div>


        <!-- Skeleton loading -->
        <div id="skeletonLoader" class="d-none">
            {{#each (times 3)}}
            <div class="card border-0 shadow-sm mb-3">
                 <div class="card-body">
                     <div class="placeholder-glow">
                          <div class="placeholder col-4 mb-2"
style="height:20px;border-radius:4px;"></div>
                          <div class="placeholder col-6"
style="height:16px;border-radius:4px;"></div>
                      </div>
                 </div>
             </div>
             {{/each}}
        </div>


        <!-- Results -->
        <div id="flightResults"></div>


        <!-- No results -->
        <div id="noResults" class="text-center py-5 d-none">
             <i class="bi bi-airplane text-muted"
style="font-size:3rem;"></i>
             <h5 class="mt-3 text-muted"> No flights found </h5>
             <p class="text-muted small"> Try a different date, origin, or
destination. </p>
        </div>


        <!-- Initial prompt -->
        <div id="searchPrompt" class="text-center py-5">
             <i class="bi bi-search text-primary"
style="font-size:3rem;opacity:0.4;"></i>
             <h5 class="mt-3 text-muted"> Search for available flights
</h5>
             <p class="text-muted small"> Enter your origin, destination,
and date above. </p>
        </div>


    </div>
</section>


<!-- Flight Details Modal -->
<div class="modal fade" id="flightDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
             <div class="modal-header">
                 <h5 class="modal-title">
                        <i class="bi bi-airplane-fill me-2 text-primary"></i>
Flight Details
                     </h5>
                     <button type="button" class="btn-close"
data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body" id="flightDetailBody"></div>
              <div class="modal-footer">
                     <button class="btn btn-secondary" data-bs-dismiss="modal">
Close </button>
                     <a href="#" class="btn btn-primary"
id="bookFromDetailBtn">
                        <i class="bi bi-ticket-perforated me-2"></i> Book This
Flight
                     </a>
              </div>
           </div>
    </div>
</div>


<script>
    let allFlights = [];


    // ── Render a flight card ──
    function renderFlightCard(f) {
           const dep = new Date(f.departureDateTime);
           const arr = new Date(f.arrivalDateTime);
           const dur = Math.round((arr - dep) / 60000);
           const h     = Math.floor(dur / 60), m = dur % 60;
           const durStr = `${h}h ${m}m`;


           const depStr = dep.toLocaleTimeString('en-PH', { hour: '2-digit',
minute: '2-digit' });
           const arrStr = arr.toLocaleTimeString('en-PH', { hour: '2-digit',
minute: '2-digit' });
           const dateStr = dep.toLocaleDateString('en-PH', { month: 'short',
day: 'numeric', year: 'numeric' });


           const seatsClass = f.seatsAvailable <= 5 ? 'text-danger' :
                            f.seatsAvailable <= 15 ? 'text-warning' :
'text-success';


        return `
              <div class="card border-0 shadow-sm mb-3">
                  <div class="card-body">
                     <div class="row align-items-center g-3">
                         <div class="col-auto">
                             <div class="bg-primary bg-opacity-10 rounded
p-2 text-center" style="min-width:60px;">
                                  <div class="fw-bold text-primary
small">${f.airline}</div>
                                  <div class="text-muted"
style="font-size:0.65rem;">${f.flightNumber}</div>
                             </div>
                         </div>
                         <div class="col">
                             <div class="d-flex align-items-center gap-3
flex-wrap">
                                  <div class="text-center">
                                      <div class="fw-bold
fs-5">${depStr}</div>
                                      <div class="fw-semibold
small">${f.origin}</div>
                                      <div class="text-muted"
style="font-size:0.7rem;">${dateStr}</div>
                                  </div>
                                  <div class="flex-grow-1 text-center">
                                      <div class="text-muted
small">${durStr}</div>
                                      <i class="bi bi-airplane-fill
text-primary"></i>
                                      <span class="badge bg-success-subtle
text-success border border-success-subtle ms-1"> Direct </span>
                                  </div>
                                  <div class="text-center">
                                      <div class="fw-bold
fs-5">${arrStr}</div>
                                      <div class="fw-semibold
small">${f.destination}</div>
                                      </div>
                               </div>
                           </div>
                           <div class="col-auto text-end">
                               <div class="fw-bold fs-4
text-primary">₱${f.ticketPrice.toLocaleString()}</div>
                               <div class="small ${seatsClass} mb-2">
                                      <i class="bi bi-person-fill
me-1"></i>${f.seatsAvailable} seats left
                               </div>
                               <a href="/flights/${f._id}/details" class="btn
btn-primary btn-sm d-block mb-1">
                                      Book Now
                               </a>
                               <button class="btn btn-outline-secondary
btn-sm d-block w-100 view-details-btn"
                                          data-id="${f._id}">
                                      Details
                               </button>
                           </div>
                     </div>
                  </div>
              </div>`;
    }


    // ── Apply sort ──
    function applySort(flights) {
        const sort = document.getElementById('sortSelect').value;
        return [...flights].sort((a, b) => {
              if (sort === 'ticketPrice')         return a.ticketPrice -
b.ticketPrice;
              if (sort === 'ticketPriceDesc') return b.ticketPrice -
a.ticketPrice;
              return new Date(a.departureDateTime) - new
Date(b.departureDateTime);
        });
    }


    // ── Render results list ──
    function renderResults(flights) {
          const container = document.getElementById('flightResults');
          document.getElementById('searchPrompt').classList.add('d-none');
          document.getElementById('skeletonLoader').classList.add('d-none');


          if (!flights.length) {
              container.innerHTML = '';


document.getElementById('noResults').classList.remove('d-none');
              document.getElementById('sortBar').style.display = 'none';
              return;
          }


          document.getElementById('noResults').classList.add('d-none');


document.getElementById('sortBar').style.removeProperty('display');
          document.getElementById('resultCount').textContent =
              `${flights.length} flight${flights.length !== 1 ? 's' : ''}
found`;
          container.innerHTML =
applySort(flights).map(renderFlightCard).join('');
    }


    // ── AJAX Search ──
    async function doSearch() {
          const origin         =
document.getElementById('origin').value.trim();
          const destination    =
document.getElementById('destination').value.trim();
          const departureDate =
document.getElementById('departureDate').value;


          document.getElementById('searchPrompt').classList.add('d-none');
          document.getElementById('noResults').classList.add('d-none');
          document.getElementById('flightResults').innerHTML = '';


document.getElementById('skeletonLoader').classList.remove('d-none');


          const params = new URLSearchParams();
          if (origin)         params.set('origin', origin);
          if (destination)    params.set('destination', destination);
        if (departureDate) params.set('departureDate', departureDate);


        try {
            const res = await fetch('/api/flights/search?' +
params.toString());
            const data = await res.json();
            allFlights = data.data || [];
            renderResults(allFlights);
        } catch (err) {


document.getElementById('skeletonLoader').classList.add('d-none');
            document.getElementById('flightResults').innerHTML =
                 '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Search failed. Please try again.</div>';
        }
    }


    // ── Flight Details Modal ──
    document.addEventListener('click', async function (e) {
        const btn = e.target.closest('.view-details-btn');
        if (!btn) return;
        const id = btn.dataset.id;
        try {
            const res     = await fetch(`/api/flights/${id}/details`);
            const data = await res.json();
            if (!data.success) throw new Error();
            const f     = data.data;
            const dep = new Date(f.departureDateTime);
            const arr = new Date(f.arrivalDateTime);
            document.getElementById('flightDetailBody').innerHTML = `
                 <div class="row g-3">
                      <div class="col-md-6">
                          <table class="table table-sm">
                              <tr><td class="text-muted small">Flight
No.</td><td class="fw-semibold">${f.flightNumber}</td></tr>
                              <tr><td class="text-muted
small">Airline</td><td class="fw-semibold">${f.airline}</td></tr>
                              <tr><td class="text-muted
small">Origin</td><td class="fw-semibold">${f.origin}</td></tr>
                                <tr><td class="text-muted
small">Destination</td><td class="fw-semibold">${f.destination}</td></tr>
                           </table>
                       </div>
                       <div class="col-md-6">
                           <table class="table table-sm">
                                <tr><td class="text-muted
small">Departure</td><td
class="fw-semibold">${dep.toLocaleString('en-PH')}</td></tr>
                                <tr><td class="text-muted
small">Arrival</td><td
class="fw-semibold">${arr.toLocaleString('en-PH')}</td></tr>
                                <tr><td class="text-muted small">Available
Seats</td><td class="fw-semibold ${f.seatsAvailable <= 5 ? 'text-danger' :
'text-success'}">${f.seatsAvailable}</td></tr>
                                <tr><td class="text-muted small">Ticket
Price</td><td class="fw-bold text-primary
fs-5">₱${f.ticketPrice.toLocaleString()}</td></tr>
                           </table>
                       </div>
                    </div>`;
              document.getElementById('bookFromDetailBtn').href =
`/flights/${f._id}/details`;
              new
bootstrap.Modal(document.getElementById('flightDetailModal')).show();
          } catch (_) {
              alert('Could not load flight details. Please try again.');
          }
    });


    // ── Sort change ──
    document.getElementById('sortSelect').addEventListener('change', () =>
renderResults(allFlights));


    // ── Search button ──
    document.getElementById('searchBtn').addEventListener('click',
doSearch);
    ['origin','destination','departureDate'].forEach(id => {
          document.getElementById(id).addEventListener('keypress', e => {
              if (e.key === 'Enter') doSearch();
            });
      });


      // ── Auto-search if query params present ──
      (function () {
            const params = new URLSearchParams(window.location.search);
            if (params.get('origin') || params.get('destination') ||
params.get('departureDate')) {
                  doSearch();
            }


      // ── AUTOMATIC INITIAL LOAD ROUTINE ──
// This runs automatically when the page is opened to fetch and display flights right away
document.addEventListener("DOMContentLoaded", async function() {
      // If the passenger hasn't typed anything yet, fetch all available flights by default
      document.getElementById('searchPrompt').classList.add('d-none');
      document.getElementById('flightResults').innerHTML = '';
      document.getElementById('skeletonLoader').classList.remove('d-none');


      try {
            // Hit your backend controller API endpoint to get all flight documents
            const res    = await fetch('/api/flights/search');
            const data = await res.json();


            // Feed the live MongoDB Atlas array results straight into your frontend renderer
            allFlights = data.flights || [];
            renderResults(allFlights);
      } catch (err) {
            console.error("Initial flight fetch failed:", err);
            document.getElementById('skeletonLoader').classList.add('d-none');
            document.getElementById('flightResults').innerHTML =
                  '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Failed to load flights from database.</div>';
      }
});
      })();
</script>


